{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "routes": [
    {
      "src": "/",
      "has": [
        {
          "type": "query",
          "key": "meta_oauth_callback",
          "value": "1"
        }
      ],
      "dest": "/api/index"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index"
    }
  ]
}
