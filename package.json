{
  "name": "nova-brain",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --watch src/local-server.js",
    "start": "node src/local-server.js",
    "test:phone-phase0": "node --test test/phone-v1-phase0.test.js",
    "test:phone-phase1": "node --test test/phone-v1-phase0.test.js test/phone-v1-phase1.test.js",
    "worker": "node scripts/worker.js",
    "worker:handoff": "node scripts/local-worker-handoff.js",
    "worker:auto": "node scripts/persistent-local-worker.js",
    "worker:auto:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-local-worker-service.ps1 install",
    "worker:auto:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-local-worker-service.ps1 status",
    "worker:auto:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-local-worker-service.ps1 uninstall",
    "worker:credentials:status": "node scripts/local-worker-credential-status.js",
    "test": "node --test",
    "db:migrate": "node scripts/migrate.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "busboy": "1.6.0",
    "fflate": "0.8.3",
    "pdfjs-dist": "6.4.299",
    "playwright-core": "1.63.0",
    "ws": "^8.21.0"
  }
}
