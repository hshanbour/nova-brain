# Local development only. Vercel supplies these through Project Settings.
PORT=3000
NODE_ENV=development
NOVA_BRAIN_MODEL_PROVIDER=mock
NOVA_BRAIN_MAX_STEPS=5
NOVA_BRAIN_MAX_TOOL_CALLS_PER_STEP=4
NOVA_BRAIN_STORAGE_PROVIDER=auto
NOVA_BRAIN_HISTORY_LIMIT=24
NOVA_BRAIN_MEMORY_LIMIT=6
NOVA_BRAIN_DEVELOPMENT_BRANCH=feat/nova-brain-mvp-foundation
# Server-only. Auto-detected when a historical Vercel/Neon integration supplies one.
DATABASE_URL=
NOVA_WORKER_ADMIN_TOKEN=
NOVA_LOCAL_WORKER_TOKEN=
# Required only when NOVA_BRAIN_MODEL_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional cost routing. Chat and no-change default to gpt-6-luna with no reasoning;
# planner remains on OPENAI_MODEL. Explicit stage values override these defaults.
# Only default (standard) and flex service tiers are accepted; premium tiers fail closed.
NOVA_BRAIN_OPENAI_SERVICE_TIER=default
NOVA_BRAIN_CHAT_MODEL=
NOVA_BRAIN_CHAT_REASONING_EFFORT=
NOVA_BRAIN_CHAT_MAX_OUTPUT_TOKENS=
NOVA_BRAIN_PLANNER_MODEL=
NOVA_BRAIN_PLANNER_REASONING_EFFORT=
NOVA_BRAIN_PLANNER_MAX_OUTPUT_TOKENS=
NOVA_BRAIN_NO_CHANGE_MODEL=
NOVA_BRAIN_NO_CHANGE_REASONING_EFFORT=
NOVA_BRAIN_NO_CHANGE_MAX_OUTPUT_TOKENS=
# Trusted prepaid-style Nova model envelope. Zero blocks model-backed calls.
# Change BUDGET_ID to start a newly authorized future-spend envelope; only a
# trusted environment/admin update may set or increase these values.
NOVA_OPENAI_BUDGET_ID=disabled
NOVA_OPENAI_GLOBAL_BUDGET_USD=0
NOVA_OPENAI_TASK_BUDGET_USD=0
# Nova Voice V2 uses OpenAI transcription plus the owner-selected ElevenLabs voice.
# Phase 0 benchmark paid calls remain independently locked by default.
NOVA_VOICE_BENCHMARK_PAID_CALLS_APPROVED=false
NOVA_VOICE_BENCHMARK_BUDGET_USD=2.00
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional comma-separated browser origins for CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional server-only developer write connection.
NOVA_BRAIN_GITHUB_TOKEN=
NOVA_BRAIN_GITHUB_REPOSITORY=hshanbour/nova-brain
# Reserved for the future Vercel inspection adapter.
NOVA_BRAIN_VERCEL_TOKEN=
NOVA_BRAIN_VERCEL_PROJECT_ID=
NOVA_BRAIN_VERCEL_TEAM_ID=
